includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app/
        - cli/
        - controllers/
        - migrations/
        - models/
        - public/
        - routes/

    # Level 10 is the highest level
    level: 8

    ignoreErrors:
        - identifier: notIdentical.alwaysFalse

#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php