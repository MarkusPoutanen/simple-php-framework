# includes:

parameters:

    paths:
        - app/
        - cli/
        - controllers/
        - migrations/
        - models/
        - public/
        - resources/
        - routes/

    # Level 10 is the highest level
    level: 8

    ignoreErrors:
        -
            identifier: notIdentical.alwaysFalse
